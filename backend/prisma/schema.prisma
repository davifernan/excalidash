generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String?              @unique
  email               String               @unique
  passwordHash        String
  name                String
  role                String               @default("USER")
  mustResetPassword   Boolean              @default(false)
  isActive            Boolean              @default(true)
  preferences         String?
  authIdentities      AuthIdentity[]
  drawings            Drawing[]            @relation("DrawingOwner")
  createdDrawings     Drawing[]            @relation("DrawingCreator")
  collections         Collection[]
  drawingPermissions  DrawingPermission[]
  collectionShares    CollectionShare[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  ownedAssets         Asset[]              @relation("AssetOwner")
  uploadedAssets      Asset[]              @relation("AssetUploader")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model SystemConfig {
  id                               String    @id @default("default")
  authEnabled                      Boolean   @default(false)
  authOnboardingCompleted          Boolean   @default(false)
  registrationEnabled              Boolean   @default(false)
  oidcJitProvisioningEnabled       Boolean?
  authLoginRateLimitEnabled        Boolean   @default(true)
  authLoginRateLimitWindowMs       Int       @default(900000)
  authLoginRateLimitMax            Int       @default(20)
  bootstrapSetupCodeHash           String?
  bootstrapSetupCodeIssuedAt       DateTime?
  bootstrapSetupCodeExpiresAt      DateTime?
  bootstrapSetupCodeFailedAttempts Int       @default(0)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
}

model Collection {
  id        String            @id @default(uuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawings  Drawing[]
  shares    CollectionShare[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, updatedAt])
}

model Drawing {
  id              String              @id @default(uuid())
  name            String
  elements        String
  appState        String
  files           String              @default("{}")
  preview         String?
  version         Int                 @default(1)
  /// Monotonic ordering marker for persisted name snapshots and broadcasts.
  nameRevision    Int                 @default(1)
  /// Who controls the board: shares it, moves it, deletes it, and carries its
  /// storage quota. For a board drawn inside someone else's collection this is
  /// the collection's owner, not the person who drew it.
  userId          String
  user            User                @relation("DrawingOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Who drew it. Kept apart from control so a team board can say where it came
  /// from without that deciding who may give it away.
  createdByUserId String?
  createdBy       User?               @relation("DrawingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  collectionId    String?
  collection      Collection?         @relation(fields: [collectionId], references: [id])
  permissions     DrawingPermission[]
  linkShares      DrawingLinkShare[]
  snapshots       DrawingSnapshot[]
  assets          DrawingAsset[]
  pageViews       DocumentPageView[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, collectionId, updatedAt])
  @@index([createdByUserId])
}

model DrawingSnapshot {
  id        String                 @id @default(uuid())
  drawingId String
  drawing   Drawing                @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  version   Int
  elements  String // JSON string (state before update)
  appState  String // JSON string
  files     String                 @default("{}")
  createdAt DateTime               @default(now())
  assets    DrawingSnapshotAsset[]

  @@index([drawingId, createdAt])
  @@index([createdAt])
}

model DrawingPermission {
  id              String   @id @default(uuid())
  drawingId       String
  drawing         Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  granteeUserId   String
  granteeUser     User     @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)
  permission      String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([drawingId, granteeUserId], name: "drawingId_granteeUserId")
  @@index([granteeUserId])
  @@index([drawingId])
}

model DrawingLinkShare {
  id              String    @id @default(uuid())
  drawingId       String
  drawing         Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  permission      String
  tokenHash       String    @unique
  passphraseHash  String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([drawingId])
}

model CollectionShare {
  id              String     @id @default(uuid())
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  granteeUserId   String
  granteeUser     User       @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)
  role            String     @default("view")
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([collectionId, granteeUserId])
  @@index([collectionId])
  @@index([granteeUserId])
}

model Library {
  id        String   @id
  items     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyId      String    @unique
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("drawings:read,drawings:write,collections:read,collections:write")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([keyId, revokedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
}

model AuthIdentity {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  issuer      String
  subject     String
  emailAtLink String
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([issuer, subject])
  @@unique([provider, userId])
  @@index([userId])
}

/// Per-(drawing, fileId) S3 object record. Excalidraw fileIds are content
/// hashes that legitimately repeat across drawings, so the primary key
/// includes drawingId to keep each reference accounted for separately.
model S3File {
  drawingId String
  fileId    String // Excalidraw fileId (same id used in Drawing.files)
  userId    String // owner who uploaded the file
  s3Key     String // full object key, e.g. "excalidash/userId/drawingId/fileId.png"
  mimeType  String
  createdAt DateTime @default(now())

  @@id([drawingId, fileId])
  @@index([userId])
  @@index([drawingId])
}

/// Bytes on disk, addressed by their content hash.
///
/// Separate from Asset on purpose: the same document dropped onto three boards
/// by three people is one file on disk but three assets, each with its own
/// name, owner and quota. Sharing Asset rows across owners instead would make
/// deleting one person's document able to take away someone else's.
model StoredBlob {
  id                  String        @id @default(uuid())
  sha256              String        @unique
  /// Size of the original content — what a reader receives.
  sizeBytes           Int
  /// Size on disk. Smaller when the content was worth compressing.
  storedBytes         Int
  /// Set when the file is stored compressed and must be served that way.
  contentEncoding     String?
  storageKey          String        @unique
  /// Origin of the bytes; preview cache blobs remain identifiable after row races.
  purpose             String        @default("ASSET")
  /// STAGING while the upload is still running, READY once it is usable,
  /// DELETING once nothing references it any more.
  state               String        @default("STAGING")
  /// Set when the last reference goes away. A grace period means a board
  /// deleted by mistake and restored from a snapshot still finds its bytes.
  deleteAfter         DateTime?
  assets              Asset[]
  linkPreviewImages   LinkPreview[] @relation("LinkPreviewImage")
  linkPreviewFavicons LinkPreview[] @relation("LinkPreviewFavicon")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([state, deleteAfter])
  @@index([purpose, createdAt])
}

/// Cached public metadata. Foreign image URLs never leave the backend; only
/// references to sanitized local blobs are exposed to board viewers.
model LinkPreview {
  id             String   @id @default(uuid())
  cacheKey       String   @unique
  requestedUrl   String
  resolvedUrl    String?
  status         String
  failureCode    String?
  title          String?
  description    String?
  imageBlobId    String?
  faviconBlobId  String?
  /// Creator charged for this cache entry. Null only for rows predating this field.
  ownerUserId    String?
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imageBlob   StoredBlob? @relation("LinkPreviewImage", fields: [imageBlobId], references: [id], onDelete: SetNull)
  faviconBlob StoredBlob? @relation("LinkPreviewFavicon", fields: [faviconBlobId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([ownerUserId, lastAccessedAt])
  @@index([lastAccessedAt])
  @@index([imageBlobId])
  @@index([faviconBlobId])
}

/// A document as a person thinks of it: a name, an owner, a page count.
model Asset {
  id               String    @id @default(uuid())
  ownerUserId      String
  /// Whoever performed the upload. May differ from the owner when someone with
  /// edit access drops a file onto a board that is not theirs; quota is still
  /// charged to the board owner.
  uploadedByUserId String?
  blobId           String
  /// PDF, MARKDOWN or TEXT.
  kind             String
  /// Shown to people and used as the download name. Never used as a path.
  originalName     String
  /// Determined by the server from the bytes, never taken from the request.
  mimeType         String
  pageCount        Int?
  status           String    @default("READY")
  deleteAfter      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner      User                   @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadedBy User?                  @relation("AssetUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  blob       StoredBlob             @relation(fields: [blobId], references: [id], onDelete: Restrict)
  drawings   DrawingAsset[]
  snapshots  DrawingSnapshotAsset[]
  pageViews  DocumentPageView[]

  @@index([ownerUserId, createdAt])
  @@index([blobId])
  @@index([status, deleteAfter])
}

/// Which documents a board currently uses.
///
/// PENDING covers the gap between uploading a file and saving the board that
/// refers to it. An upload nobody ever saved is swept up rather than kept.
model DrawingAsset {
  drawingId String
  assetId   String
  state     String    @default("PENDING")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([drawingId, assetId])
  @@index([assetId])
  @@index([state, expiresAt])
}

/// Which page of a document everyone in the room is looking at.
///
/// Deliberately not part of the board. A page turn is not a drawing change: it
/// must not bump an element version, land in undo history, or collide with
/// somebody moving a shape at the same moment. Keeping it beside the board also
/// means a read-only visitor can still be shown the page the room is on.
///
/// One row per widget, not per document, so the same file placed twice can show
/// two different pages side by side.
model DocumentPageView {
  drawingId String
  /// The embeddable element carrying the widget. Not a foreign key: elements
  /// live inside the board's JSON, so nothing here can point at them.
  elementId String
  assetId   String
  page      Int
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([drawingId, elementId])
  @@index([assetId])
}

/// Which documents a snapshot needs, so restoring an old version still finds
/// the file it referred to.
model DrawingSnapshotAsset {
  snapshotId String
  assetId    String

  snapshot DrawingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  asset    Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([snapshotId, assetId])
  @@index([assetId])
}
