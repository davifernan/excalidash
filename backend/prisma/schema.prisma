generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String?              @unique
  email               String               @unique
  passwordHash        String
  name                String
  role                String               @default("USER")
  mustResetPassword   Boolean              @default(false)
  isActive            Boolean              @default(true)
  preferences         String?
  authIdentities      AuthIdentity[]
  drawings            Drawing[]            @relation("DrawingOwner")
  createdDrawings     Drawing[]            @relation("DrawingCreator")
  collections         Collection[]
  drawingPermissions  DrawingPermission[]
  collectionShares    CollectionShare[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  ownedAssets         Asset[]              @relation("AssetOwner")
  uploadedAssets      Asset[]              @relation("AssetUploader")
  authoredComments    Comment[]            @relation("CommentAuthor")
  resolvedComments    Comment[]            @relation("CommentResolver")
  deletedComments     Comment[]            @relation("CommentDeleter")
  mentionedIn         Mention[]            @relation("MentionedUser")
  activityEvents      ActivityEvent[]      @relation("ActivityActor")
  notifications       Notification[]       @relation("NotificationRecipient")
  drawingVisits       DrawingVisit[]
  drawingFavorites    DrawingFavorite[]
  teamActivityVisit   TeamActivityVisit?
  libraryItems        LibraryItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// The team this instance serves. Deliberately a singleton (id fixed to
/// "default", like SystemConfig): the product is built for one team of about
/// ten people per self-hosted install, not for multi-tenant workspaces
/// (explicit non-goal, see docs/product/PRODUCT_VISION.md). Every active
/// `User` is implicitly this team's member -- there is no separate membership
/// table, because a second place to record "who is on the team" would be a
/// second copy of a fact `User.isActive` already holds, and this project has
/// already paid once for a duplicated authority (see ACCESS_RANK in
/// authz/sharing.ts). Team role is `User.role` (ADMIN/USER), read through
/// authz/team.ts rather than duplicated here.
model Team {
  id        String   @id @default("default")
  name      String   @default("Team")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  id                                 String    @id @default("default")
  authEnabled                        Boolean   @default(false)
  authOnboardingCompleted            Boolean   @default(false)
  registrationEnabled                Boolean   @default(false)
  guestUploadEnabled                 Boolean   @default(false)
  guestCommentVisibilityEnabled      Boolean   @default(true)
  guestAgentContextContributeEnabled Boolean   @default(false)
  oidcJitProvisioningEnabled         Boolean?
  authLoginRateLimitEnabled          Boolean   @default(true)
  authLoginRateLimitWindowMs         Int       @default(900000)
  authLoginRateLimitMax              Int       @default(20)
  bootstrapSetupCodeHash             String?
  bootstrapSetupCodeIssuedAt         DateTime?
  bootstrapSetupCodeExpiresAt        DateTime?
  bootstrapSetupCodeFailedAttempts   Int       @default(0)
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
}

model Collection {
  id        String            @id @default(uuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawings  Drawing[]
  shares    CollectionShare[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, updatedAt])
}

model Drawing {
  id                                 String                          @id @default(uuid())
  name                               String
  elements                           String
  appState                           String
  files                              String                          @default("{}")
  preview                            String?
  version                            Int                             @default(1)
  guestUploadEnabled                 Boolean                         @default(false)
  guestCommentVisibilityEnabled      Boolean                         @default(true)
  guestAgentContextContributeEnabled Boolean                         @default(false)
  /// Monotonic ordering marker for persisted name snapshots and broadcasts.
  nameRevision                       Int                             @default(1)
  /// Who controls the board: shares it, moves it, deletes it, and carries its
  /// storage quota. For a board drawn inside someone else's collection this is
  /// the collection's owner, not the person who drew it.
  userId                             String
  user                               User                            @relation("DrawingOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Who drew it. Kept apart from control so a team board can say where it came
  /// from without that deciding who may give it away.
  createdByUserId                    String?
  createdBy                          User?                           @relation("DrawingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  collectionId                       String?
  collection                         Collection?                     @relation(fields: [collectionId], references: [id])
  permissions                        DrawingPermission[]
  linkShares                         DrawingLinkShare[]
  snapshots                          DrawingSnapshot[]
  assets                             DrawingAsset[]
  pageViews                          DocumentPageView[]
  elementGuestProvenance             DrawingElementGuestProvenance[]
  comments                           Comment[]
  activityEvents                     ActivityEvent[]
  visits                             DrawingVisit[]
  favoritedBy                        DrawingFavorite[]
  apiKeys                            ApiKey[]
  agentContexts                      AgentContext[]
  agentThreads                       AgentThread[]
  agentRevisions                     AgentBoardRevision[]
  agentRunMounts                     AgentRunMount[]
  agentSemanticRelations             AgentSemanticRelation[]
  agentInstructionApprovals          AgentInstructionApproval[]
  /// Not named `files` -- the scalar `files` column below is Drawing's own
  /// JSON blob of embedded Excalidraw file entries, an unrelated field this
  /// relation would collide with.
  drawingFiles                       DrawingFile[]
  /// Set when the board is archived (NIL-365): excluded from Team Home, the
  /// default drawing lists, and search by default, but not deleted -- an
  /// authorized viewer can still find and restore it from the Archive view.
  /// Distinct from Trash (`collectionId` pointing at the per-account
  /// `trash:<userId>` collection, see `routes/dashboard/trash.ts`): Trash is
  /// staging for permanent deletion by the board's own owner, Archive is a
  /// reversible team-visible lifecycle state that does not change ownership
  /// or collection membership.
  archivedAt                         DateTime?
  /// Denormalized, lowercased plain text extracted from the board's name and
  /// its visible text-element content, recomputed on every save
  /// (`searchIndex.ts`). Existing purely so `contains` search has one column
  /// to match against instead of parsing `elements` JSON per request; it is
  /// never returned to a client and never the source of truth (`elements`
  /// is). SQLite `LIKE`-based, not FTS5: at ~10 accounts and their boards
  /// this is cheap enough that a second, rebuildable virtual index is not
  /// worth the dual-write hazard it would add.
  searchText                         String                          @default("")
  createdAt                          DateTime                        @default(now())
  updatedAt                          DateTime                        @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, collectionId, updatedAt])
  @@index([createdByUserId])
  @@index([archivedAt])
}

model DrawingSnapshot {
  id        String                 @id @default(uuid())
  drawingId String
  drawing   Drawing                @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  version   Int
  elements  String // JSON string (state before update)
  appState  String // JSON string
  files     String                 @default("{}")
  createdAt DateTime               @default(now())
  assets    DrawingSnapshotAsset[]

  @@index([drawingId, createdAt])
  @@index([createdAt])
}

/// The server-authoritative identity of a board Context. The frame is an
/// Excalidraw element id rather than a foreign key because elements live in
/// Drawing.elements JSON. A frame can identify at most one Context.
model AgentContext {
  id             String   @id @default(uuid())
  drawingId      String
  frameElementId String
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  drawing              Drawing                    @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  thread               AgentThread?
  semanticRelations    AgentSemanticRelation[]
  instructionApprovals AgentInstructionApproval[]
  lease                ContextLease?
  leaseEvents          ContextLeaseEvent[]

  @@unique([drawingId, frameElementId])
  @@index([drawingId, createdAt])
}

/// One immutable-audience conversation. Context and orchestrator histories use
/// the same ordered event domain; audience/owner are properties of the thread,
/// never per-message flags that a later toggle could reinterpret.
model AgentThread {
  id                String   @id @default(uuid())
  drawingId         String
  threadKind        String
  audienceKind      String
  /// Server-authenticated subject id. Deliberately not a User FK: the
  /// supported auth-disabled bootstrap identity has no User row, but is still
  /// stable across devices and must be able to own a local thread.
  audienceUserId    String?
  contextId         String?  @unique
  anchorElementId   String?
  title             String
  anchorX           Float?
  anchorY           Float?
  nextEventSequence Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  drawing Drawing            @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  context AgentContext?      @relation(fields: [contextId], references: [id], onDelete: Cascade)
  events  AgentThreadEvent[]

  // SQLite and PostgreSQL both allow multiple NULLs here: there can be many
  // drawing-audience Context/shared threads, but only one private orchestrator
  // thread per account and board.
  @@unique([drawingId, threadKind, audienceUserId])
  @@unique([drawingId, anchorElementId])
  @@index([drawingId, audienceKind, createdAt])
  @@index([audienceUserId, updatedAt])
}

/// Server-ordered, append-only history for any AgentThread. The actor is
/// deliberately polymorphic: agents and system events are not fake User rows.
/// `payload` is event-kind-specific JSON; clients never overwrite or delete a
/// row after append.
model AgentThreadEvent {
  id               String   @id @default(uuid())
  threadId         String
  sequence         Int
  actorKind        String
  actorId          String?
  actorDisplayName String
  eventKind        String
  payload          String
  createdAt        DateTime @default(now())

  thread AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, sequence])
  @@index([threadId, createdAt])
}

/// A full, immutable source image for agent exploration. Unlike ordinary
/// DrawingSnapshot history, these rows are retained for as long as a run
/// mount needs them and store the Context identity captured with the scene.
model AgentBoardRevision {
  id                   String   @id @default(uuid())
  drawingId            String
  sourceDrawingVersion Int
  contentHash          String
  elements             String
  appState             String
  files                String
  contextMap           String
  /// Explicit, server-owned instruction relations captured with this scene.
  /// Dispatch validates an approval against this immutable map, never a live
  /// relation set that may have changed after the run was pinned.
  semanticRelations    String   @default("[]")
  createdAt            DateTime @default(now())

  drawing Drawing                   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  mounts  AgentRunMount[]
  assets  AgentBoardRevisionAsset[]
  audits  AgentToolAudit[]

  @@unique([drawingId, contentHash])
  @@index([drawingId, createdAt])
}

/// Explicit machine meaning for an Agent Context. This is deliberately not
/// Excalidraw arrow geometry or `customData`: only a human-authorized route
/// may create it, and it is separately captured in AgentBoardRevision.
model AgentSemanticRelation {
  id              String   @id @default(uuid())
  drawingId       String
  contextId       String
  fromElementId   String
  toElementId     String
  kind            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  drawing Drawing      @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  context AgentContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, fromElementId, toElementId, kind])
  @@index([drawingId, contextId, createdAt])
}

/// Human approval is server state, not an element flag. The hash pair is the
/// exact semantic instruction and transitive explicit closure the human saw.
model AgentInstructionApproval {
  id                 String   @id @default(uuid())
  drawingId          String
  contextId          String
  elementId          String
  schemaVersion      Int
  semanticHash       String
  closureHash        String
  approvedByUserId   String
  authority          String   @default("instruction")
  approvedRevisionId String?
  approvedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  drawing Drawing      @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  context AgentContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@unique([contextId, elementId])
  @@index([drawingId, contextId, approvedAt])
}

/// NIL-680. The single, reusable row of public-effect exclusivity for one
/// Context. There is deliberately no read lease -- any number of read-only
/// runs may explore a Context in parallel; this row exists only to answer
/// "which run may currently cause a shared, board-visible effect through
/// this Context." One row is created once per Context and then mutated in
/// place by every later acquire/renew/transfer -- `leaseGeneration` is the
/// opaque token a caller must present back for renew/transfer/release to
/// prove it still addresses the lease it thinks it holds, not a stale one.
/// A lease with `releasedAt` set or `expiresAt` in the past is not held by
/// anyone; acquiring against it is a fresh grant, not a hostile takeover.
model ContextLease {
  id                   String    @id @default(uuid())
  contextId            String    @unique
  leaseGeneration      String
  holderOrchestratorId String
  initiatedByUserId    String
  runId                String
  acquiredAt           DateTime
  expiresAt            DateTime
  endHorizonAt         DateTime
  releasedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  context AgentContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([contextId, expiresAt])
}

/// NIL-680's own coordination trace -- deliberately separate from
/// AgentThreadEvent/contextThread.ts's narrative log (message/tool/status/
/// artifact/dispatch), which has its own closed event-kind union and its own
/// per-context sequence counter that this module has no reason to couple
/// into. This is lower-level protocol bookkeeping: every acquire attempt,
/// grant, busy rejection, transfer, expiry, and release, in the order the
/// server observed them. Append-only, never mutated -- there is no
/// edit/retract concept for a Lease's own history.
model ContextLeaseEvent {
  id                   String   @id @default(uuid())
  contextId            String
  kind                 String
  holderOrchestratorId String?
  initiatedByUserId    String?
  runId                String?
  payload              String
  createdAt            DateTime @default(now())

  context AgentContext @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@index([contextId, createdAt])
}

/// The per-run pin. The opaque capability token is returned once and only its
/// SHA-256 is stored; every tool request must present it as well as pass the
/// normal board authorization boundary.
model AgentRunMount {
  runId               String   @id
  drawingId           String
  revisionId          String
  allowedContextIds   String
  capabilities        String
  capabilityTokenHash String   @unique
  /// Board-facing participant identity, fixed for the run.
  displayName         String   @default("Agent")
  /// `private` reaches only audienceUserId; `drawing` reaches authorized
  /// human sockets currently present on the board.
  audienceKind        String   @default("private")
  /// Derived from the authenticated mount issuer, never supplied as an id by
  /// the caller.
  audienceUserId      String?
  createdAt           DateTime @default(now())

  drawing  Drawing            @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  revision AgentBoardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  audits   AgentToolAudit[]

  @@index([drawingId, createdAt])
  @@index([revisionId])
}

/// Hash-only audit trail for the public exploration surface. It proves which
/// pinned revision and projection produced an answer without persisting a
/// second copy of that answer.
model AgentToolAudit {
  id         String   @id @default(uuid())
  runId      String
  revisionId String
  tool       String
  argsHash   String
  resultHash String
  createdAt  DateTime @default(now())

  mount    AgentRunMount      @relation(fields: [runId], references: [runId], onDelete: Cascade)
  revision AgentBoardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
  @@index([revisionId])
}

model DrawingPermission {
  id              String   @id @default(uuid())
  drawingId       String
  drawing         Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  granteeUserId   String
  granteeUser     User     @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)
  permission      String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([drawingId, granteeUserId], name: "drawingId_granteeUserId")
  @@index([granteeUserId])
  @@index([drawingId])
}

model DrawingLinkShare {
  id              String    @id @default(uuid())
  drawingId       String
  drawing         Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  permission      String
  tokenHash       String    @unique
  passphraseHash  String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([drawingId])
}

model CollectionShare {
  id              String     @id @default(uuid())
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  granteeUserId   String
  granteeUser     User       @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)
  role            String     @default("view")
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([collectionId, granteeUserId])
  @@index([collectionId])
  @@index([granteeUserId])
}

/// A comment or a reply, anchored to a board.
///
/// A thread has no table of its own: the root comment (`rootId == null`) IS
/// the thread. Resolve/reopen only ever apply to a root; a reply inherits its
/// thread's state by following `rootId`, so there is exactly one place that
/// says whether a conversation is open. Two tables describing the same
/// conversation is the mistake this project already paid for once (see
/// ACCESS_RANK in authz/sharing.ts) and NIL-324's exit criteria name it by
/// name: no separate comment/activity truths.
///
/// Deliberately no edit-history table: an edit overwrites `body` and stamps
/// `editedAt`; prior text is not retained. A delete is a tombstone
/// (`deletedAt` set, `body` cleared) rather than a row removal, so a reply
/// chain never loses its root out from under it.
///
/// `elementId`/`anchorX`/`anchorY` are not foreign keys: canvas elements live
/// inside `Drawing.elements` JSON, not in a relational table (see
/// DocumentPageView above for the same shape). Whether that element still
/// exists is resolved by the client against the live scene it already holds
/// -- the server stores the anchor, it does not police it. A vanished element
/// degrades the thread to board-level context; it does not delete the
/// comment.
model Comment {
  id               String    @id @default(uuid())
  drawingId        String
  drawing          Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  /// Null on a thread root. Points at the root on every reply.
  rootId           String?
  root             Comment?  @relation("CommentReplies", fields: [rootId], references: [id], onDelete: Cascade)
  replies          Comment[] @relation("CommentReplies")
  /// Set once, from the server's own session/auth read -- never from the
  /// request body. A guest holding only an unauthenticated link cannot
  /// author a comment at all (see docs/architecture/... HANDOFF for the
  /// Gastpfad decision); every row here has a real account behind it.
  authorUserId     String
  author           User      @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body             String
  elementId        String?
  anchorX          Float?
  anchorY          Float?
  /// Root-only. A reply's resolved state is read off its root.
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolvedBy       User?     @relation("CommentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  editedAt         DateTime?
  deletedAt        DateTime?
  deletedByUserId  String?
  deletedBy        User?     @relation("CommentDeleter", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  mentions       Mention[]
  activityEvents ActivityEvent[]

  @@index([drawingId, rootId, createdAt])
  @@index([drawingId, resolvedAt])
  @@index([authorUserId])
  @@index([rootId])
}

/// One row per person named in a comment, idempotent on retry.
///
/// The mention target is re-validated server-side against the drawing's
/// roster at write time -- the client's picker only narrows what is offered,
/// it is never trusted for who actually gets notified (NIL-353: no
/// information about people who cannot see the board).
model Mention {
  id              String   @id @default(uuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
}

/// The append-only feed a comment, mention, resolve or reopen writes into.
///
/// This is the one truth the Activity Feed, the Inbox and Notifications all
/// read -- none of them keep their own copy of "what happened". `commentId`
/// is the authoritative link back to current state; `elementId`/anchor and
/// `summary` are a snapshot taken at event time so an edit made an hour later
/// does not silently rewrite what the feed already showed.
model ActivityEvent {
  id          String   @id @default(uuid())
  drawingId   String
  drawing     Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  /// "comment.created" | "comment.edited" | "comment.resolved" |
  /// "comment.reopened" | "comment.deleted" | "mention.created"
  verb        String
  commentId   String?
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  elementId   String?
  anchorX     Float?
  anchorY     Float?
  summary     String
  createdAt   DateTime @default(now())

  notifications Notification[]

  @@index([drawingId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([commentId])
}

/// One notification per recipient per event. The unique constraint is what
/// makes fan-out idempotent: a retried "create comment" request re-runs
/// mention resolution, and must not hand the same person a second unread row
/// for the same event.
model Notification {
  id              String        @id @default(uuid())
  recipientUserId String
  recipient       User          @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  activityEventId String
  activityEvent   ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)
  /// "mention" | "reply" | "resolve"
  kind            String
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  @@unique([recipientUserId, activityEventId])
  @@index([recipientUserId, readAt, createdAt])
}

/// When this account last opened this board, for its own "new since you were
/// last here" marker. Upserted on join, never read by anyone but its owner.
model DrawingVisit {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawingId     String
  drawing       Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  lastVisitedAt DateTime @default(now())

  @@id([userId, drawingId])
  @@index([drawingId])
}

/// Whether this account has starred this board (NIL-292). Per-viewer, like
/// `DrawingVisit` above -- a board has no single "is it a favorite" answer,
/// only "is it a favorite of the person asking".
model DrawingFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, drawingId])
  @@index([drawingId])
}

/// The same marker, once per account, for the team-wide Activity Feed rather
/// than one board. A second table rather than a sentinel drawingId in
/// DrawingVisit: "the team feed" is not a board and should not pretend to be
/// one to reuse a row shape.
model TeamActivityVisit {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
}

/// Replaces the flat, per-account `Library { id: "user_<userId>", items }` blob
/// (NIL-364): one row per Excalidraw library item instead of one row per
/// account holding a whole-array JSON blob, so an item can carry its own
/// ownership and visibility instead of inheriting whichever account's blob it
/// happened to live in.
///
/// `excalidrawItemId`/`excalidrawData` mirror Excalidraw's own native library
/// item shape (`{id, status, elements, created}` from `api.getLibrary()`) --
/// this table is what `GET/PUT /library` (the sync contract Excalidraw's own
/// uncontrolled library panel already expects, wired in
/// `useEditorSceneLoader.ts`/`useEditorPersistence.ts`) reads from and writes
/// to. `excalidrawItemId` is Excalidraw's own item id, not this row's `id`;
/// it is the identity `PUT /library`'s array-diff matches on to tell "this
/// account edited an item it already owns" apart from "this is a new item".
///
/// `visibility` is the "Team/persoenlich" split the acceptance slice names:
/// `"personal"` is invisible to every other account (the case
/// "nicht sichtbare Teamitems leaken nicht" in NIL-364 actually exercises),
/// `"team"` is visible to every active team member. There is no `teamId` --
/// `Team` is the one singleton NIL-323 built, so "team" here means exactly
/// that one team.
model LibraryItem {
  id               String   @id @default(uuid())
  excalidrawItemId String
  name             String
  category         String?
  visibility       String   @default("personal")
  ownerUserId      String
  owner            User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  excalidrawData   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([ownerUserId, excalidrawItemId])
  @@index([visibility, category])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// `drawingId == null` is an account-wide key: it carries `drawings:*`/
/// `collections:*` scopes and reaches every board the owning account can
/// reach. `drawingId != null` is an agent token confined to exactly that
/// board (NIL-382): it carries only `drawing:read`/`drawing:ops` (a
/// disjoint scope namespace on purpose -- `drawing:` singular vs
/// `drawings:` plural makes the two families impossible to confuse at a
/// glance or in a grep) and is refused everywhere except the three agent
/// routes named in `middleware/auth.ts`'s `getAgentRouteDrawingId`. It is
/// also refused outright at the socket handshake
/// (`server/socketAuth.ts`) rather than threaded through the dozen
/// per-feature socket handlers (voting, presenter, workshop timer, cursor
/// chat, follow, invite-here, ...) that would each need their own copy of
/// the same board-match check to stay safe -- one refusal at the door is
/// the whole enforcement, not a property every future handler must
/// remember to preserve.
///
/// `expiresAt` is enforced for both key types wherever a key is resolved
/// (`auth/apiKeys.ts#resolveApiKeyUser`, shared by the HTTP middleware and
/// the socket handshake). Account-wide keys keep it null (never expire,
/// unchanged product behavior). Agent tokens always get one: 30 days by
/// default if the caller does not name a shorter one. Before this, the
/// product's advertised "agent tokens expire after 30 days" was not true
/// of any key this table could produce.
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyId      String    @unique
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("drawings:read,drawings:write,collections:read,collections:write")
  drawingId  String?
  drawing    Drawing?  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([keyId, revokedAt])
  @@index([drawingId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
}

model AuthIdentity {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  issuer      String
  subject     String
  emailAtLink String
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([issuer, subject])
  @@unique([provider, userId])
  @@index([userId])
}

/// Per-(drawing, fileId) S3 object record. Excalidraw fileIds are content
/// hashes that legitimately repeat across drawings, so the primary key
/// includes drawingId to keep each reference accounted for separately.
///
/// Superseded by DrawingFile (NIL-381) for every new image: this table stops
/// gaining rows once the S3-only embed-interception path is retired, but
/// existing rows keep serving through GET /files/:drawingId/:fileId so a
/// private-bucket deployment that already has images here does not lose
/// them. A full backfill/removal is its own follow-up, not a blind SQL
/// migration -- moving these bytes means real S3 network calls, which do not
/// belong inside a schema migration.
model S3File {
  drawingId String
  fileId    String // Excalidraw fileId (same id used in Drawing.files)
  userId    String // owner who uploaded the file
  s3Key     String // full object key, e.g. "excalidash/userId/drawingId/fileId.png"
  mimeType  String
  createdAt DateTime @default(now())

  @@id([drawingId, fileId])
  @@index([userId])
  @@index([drawingId])
}

/// Per-(drawing, fileId) reference to an embedded image's bytes (NIL-381):
/// where S3File always meant "in S3", this means "in the shared
/// content-addressed blob store" (StoredBlob, purpose "IMAGE") -- the same
/// store, dedup, quota and grace-period-cleanup discipline `assetService.ts`
/// already built for uploaded documents, reused rather than duplicated.
/// `ownerUserId` is denormalized here the same way `Asset.ownerUserId` is:
/// quota is charged to whoever owns the board a file was uploaded to, not
/// whoever uploaded it, and a quota query needs that without a join through
/// Drawing on every request.
model DrawingFile {
  drawingId   String
  fileId      String // Excalidraw fileId (same id used in Drawing.files)
  blobId      String
  ownerUserId String
  mimeType    String
  createdAt   DateTime @default(now())

  drawing Drawing    @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  blob    StoredBlob @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@id([drawingId, fileId])
  @@index([blobId])
  @@index([ownerUserId])
}

/// Bytes on disk, addressed by their content hash.
///
/// Separate from Asset on purpose: the same document dropped onto three boards
/// by three people is one file on disk but three assets, each with its own
/// name, owner and quota. Sharing Asset rows across owners instead would make
/// deleting one person's document able to take away someone else's.
model StoredBlob {
  id                  String        @id @default(uuid())
  sha256              String        @unique
  /// Size of the original content — what a reader receives.
  sizeBytes           Int
  /// Size on disk. Smaller when the content was worth compressing.
  storedBytes         Int
  /// Set when the file is stored compressed and must be served that way.
  contentEncoding     String?
  storageKey          String        @unique
  /// Origin of the bytes; preview cache blobs remain identifiable after row
  /// races. "ASSET" (uploaded documents), "LINK_PREVIEW" (cached preview
  /// images), or "IMAGE" (NIL-381: images embedded in a board's scene,
  /// referenced through DrawingFile rather than Asset).
  purpose             String        @default("ASSET")
  /// STAGING while the upload is still running, READY once it is usable,
  /// DELETING once nothing references it any more.
  state               String        @default("STAGING")
  /// Set when the last reference goes away. A grace period means a board
  /// deleted by mistake and restored from a snapshot still finds its bytes.
  deleteAfter         DateTime?
  assets              Asset[]
  drawingFiles        DrawingFile[]
  linkPreviewImages   LinkPreview[] @relation("LinkPreviewImage")
  linkPreviewFavicons LinkPreview[] @relation("LinkPreviewFavicon")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([state, deleteAfter])
  @@index([purpose, createdAt])
}

/// Cached public metadata. Foreign image URLs never leave the backend; only
/// references to sanitized local blobs are exposed to board viewers.
model LinkPreview {
  id             String   @id @default(uuid())
  cacheKey       String   @unique
  requestedUrl   String
  resolvedUrl    String?
  status         String
  failureCode    String?
  title          String?
  description    String?
  imageBlobId    String?
  faviconBlobId  String?
  /// Creator charged for this cache entry. Null only for rows predating this field.
  ownerUserId    String?
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imageBlob   StoredBlob? @relation("LinkPreviewImage", fields: [imageBlobId], references: [id], onDelete: SetNull)
  faviconBlob StoredBlob? @relation("LinkPreviewFavicon", fields: [faviconBlobId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([ownerUserId, lastAccessedAt])
  @@index([lastAccessedAt])
  @@index([imageBlobId])
  @@index([faviconBlobId])
}

/// A document as a person thinks of it: a name, an owner, a page count.
model Asset {
  id               String    @id @default(uuid())
  ownerUserId      String
  /// Whoever performed the upload. May differ from the owner when someone with
  /// edit access drops a file onto a board that is not theirs; quota is still
  /// charged to the board owner.
  uploadedByUserId String?
  blobId           String
  /// PDF, MARKDOWN or TEXT.
  kind             String
  /// Shown to people and used as the download name. Never used as a path.
  originalName     String
  /// Determined by the server from the bytes, never taken from the request.
  mimeType         String
  pageCount        Int?
  status           String    @default("READY")
  deleteAfter      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner      User                   @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadedBy User?                  @relation("AssetUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  blob       StoredBlob             @relation(fields: [blobId], references: [id], onDelete: Restrict)
  drawings   DrawingAsset[]
  snapshots  DrawingSnapshotAsset[]
  pageViews  DocumentPageView[]

  @@index([ownerUserId, createdAt])
  @@index([blobId])
  @@index([status, deleteAfter])
}

/// Which documents a board currently uses.
///
/// PENDING covers the gap between uploading a file and saving the board that
/// refers to it. An upload nobody ever saved is swept up rather than kept.
model DrawingAsset {
  drawingId String
  assetId   String
  state     String    @default("PENDING")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([drawingId, assetId])
  @@index([assetId])
  @@index([state, expiresAt])
}

/// Which page of a document everyone in the room is looking at.
///
/// Deliberately not part of the board. A page turn is not a drawing change: it
/// must not bump an element version, land in undo history, or collide with
/// somebody moving a shape at the same moment. Keeping it beside the board also
/// means a read-only visitor can still be shown the page the room is on.
///
/// One row per widget, not per document, so the same file placed twice can show
/// two different pages side by side.
model DocumentPageView {
  drawingId String
  /// The embeddable element carrying the widget. Not a foreign key: elements
  /// live inside the board's JSON, so nothing here can point at them.
  elementId String
  assetId   String
  page      Int
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([drawingId, elementId])
  @@index([assetId])
}

/// Whether an element has definitely been changed by a link-only guest.
///
/// Absence is deliberately NOT equivalent to false: elements that predate
/// this table have unknown provenance. `false` is only written for a
/// server-observed member creation or an explicit member confirmation;
/// `true` is monotonic across ordinary writes and is only cleared by that
/// explicit, audited confirmation path.
///
/// `elementId` is not a foreign key because elements live in Drawing.elements
/// JSON rather than in their own table (the same boundary as DocumentPageView).
model DrawingElementGuestProvenance {
  drawingId        String
  elementId        String
  everGuestTouched Boolean
  /// Optimistic guard for the explicit reset: a concurrent guest touch wins.
  revision         Int      @default(1)
  updatedAt        DateTime @updatedAt

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@id([drawingId, elementId])
  @@index([drawingId, everGuestTouched])
}

/// Which documents a snapshot needs, so restoring an old version still finds
/// the file it referred to.
model DrawingSnapshotAsset {
  snapshotId String
  assetId    String

  snapshot DrawingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  asset    Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([snapshotId, assetId])
  @@index([assetId])
}

/// An immutable asset binding captured with an AgentBoardRevision. Metadata is
/// copied so a later rename cannot change a mounted tool result, and that copy
/// is deliberately the entire record: `assetId` is a historical pointer, not
/// an enforced foreign key. A revision must know WHICH assets it once
/// included, but must not force those assets to live forever -- the ordinary
/// asset cleanup job (assetService.ts collectExpired) is the honest owner of
/// blob retention, and a Restrict relation here would silently make it unable
/// to ever delete an asset any revision had ever touched (NIL-671 review,
/// 2026-08-29). If the live Asset is gone by the time a run calls
/// readAsset({mode:"content"}), that's reported as ASSET_NO_LONGER_AVAILABLE
/// using this row's own metadata -- metadata mode never needed the live row.
model AgentBoardRevisionAsset {
  revisionId   String
  assetId      String
  contentHash  String
  kind         String
  originalName String
  mimeType     String
  sizeBytes    Int

  revision AgentBoardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@id([revisionId, assetId])
  @@index([assetId])
}
