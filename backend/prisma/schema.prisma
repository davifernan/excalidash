generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  username            String?              @unique
  email               String               @unique
  passwordHash        String
  name                String
  role                String               @default("USER")
  mustResetPassword   Boolean              @default(false)
  isActive            Boolean              @default(true)
  preferences         String?
  authIdentities      AuthIdentity[]
  drawings            Drawing[]            @relation("DrawingOwner")
  createdDrawings     Drawing[]            @relation("DrawingCreator")
  collections         Collection[]
  drawingPermissions  DrawingPermission[]
  collectionShares    CollectionShare[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  ownedAssets         Asset[]              @relation("AssetOwner")
  uploadedAssets      Asset[]              @relation("AssetUploader")
  authoredComments    Comment[]            @relation("CommentAuthor")
  resolvedComments    Comment[]            @relation("CommentResolver")
  deletedComments     Comment[]            @relation("CommentDeleter")
  mentionedIn         Mention[]            @relation("MentionedUser")
  activityEvents      ActivityEvent[]      @relation("ActivityActor")
  notifications       Notification[]       @relation("NotificationRecipient")
  drawingVisits       DrawingVisit[]
  teamActivityVisit   TeamActivityVisit?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// The team this instance serves. Deliberately a singleton (id fixed to
/// "default", like SystemConfig): the product is built for one team of about
/// ten people per self-hosted install, not for multi-tenant workspaces
/// (explicit non-goal, see docs/product/PRODUCT_VISION.md). Every active
/// `User` is implicitly this team's member -- there is no separate membership
/// table, because a second place to record "who is on the team" would be a
/// second copy of a fact `User.isActive` already holds, and this project has
/// already paid once for a duplicated authority (see ACCESS_RANK in
/// authz/sharing.ts). Team role is `User.role` (ADMIN/USER), read through
/// authz/team.ts rather than duplicated here.
model Team {
  id        String   @id @default("default")
  name      String   @default("Team")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemConfig {
  id                               String    @id @default("default")
  authEnabled                      Boolean   @default(false)
  authOnboardingCompleted          Boolean   @default(false)
  registrationEnabled              Boolean   @default(false)
  oidcJitProvisioningEnabled       Boolean?
  authLoginRateLimitEnabled        Boolean   @default(true)
  authLoginRateLimitWindowMs       Int       @default(900000)
  authLoginRateLimitMax            Int       @default(20)
  bootstrapSetupCodeHash           String?
  bootstrapSetupCodeIssuedAt       DateTime?
  bootstrapSetupCodeExpiresAt      DateTime?
  bootstrapSetupCodeFailedAttempts Int       @default(0)
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
}

model Collection {
  id        String            @id @default(uuid())
  name      String
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawings  Drawing[]
  shares    CollectionShare[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, updatedAt])
}

model Drawing {
  id              String              @id @default(uuid())
  name            String
  elements        String
  appState        String
  files           String              @default("{}")
  preview         String?
  version         Int                 @default(1)
  /// Monotonic ordering marker for persisted name snapshots and broadcasts.
  nameRevision    Int                 @default(1)
  /// Who controls the board: shares it, moves it, deletes it, and carries its
  /// storage quota. For a board drawn inside someone else's collection this is
  /// the collection's owner, not the person who drew it.
  userId          String
  user            User                @relation("DrawingOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// Who drew it. Kept apart from control so a team board can say where it came
  /// from without that deciding who may give it away.
  createdByUserId String?
  createdBy       User?               @relation("DrawingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  collectionId    String?
  collection      Collection?         @relation(fields: [collectionId], references: [id])
  permissions     DrawingPermission[]
  linkShares      DrawingLinkShare[]
  snapshots       DrawingSnapshot[]
  assets          DrawingAsset[]
  pageViews       DocumentPageView[]
  comments        Comment[]
  activityEvents  ActivityEvent[]
  visits          DrawingVisit[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, collectionId, updatedAt])
  @@index([createdByUserId])
}

model DrawingSnapshot {
  id        String                 @id @default(uuid())
  drawingId String
  drawing   Drawing                @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  version   Int
  elements  String // JSON string (state before update)
  appState  String // JSON string
  files     String                 @default("{}")
  createdAt DateTime               @default(now())
  assets    DrawingSnapshotAsset[]

  @@index([drawingId, createdAt])
  @@index([createdAt])
}

model DrawingPermission {
  id              String   @id @default(uuid())
  drawingId       String
  drawing         Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  granteeUserId   String
  granteeUser     User     @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)
  permission      String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([drawingId, granteeUserId], name: "drawingId_granteeUserId")
  @@index([granteeUserId])
  @@index([drawingId])
}

model DrawingLinkShare {
  id              String    @id @default(uuid())
  drawingId       String
  drawing         Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  permission      String
  tokenHash       String    @unique
  passphraseHash  String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([drawingId])
}

model CollectionShare {
  id              String     @id @default(uuid())
  collectionId    String
  collection      Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  granteeUserId   String
  granteeUser     User       @relation(fields: [granteeUserId], references: [id], onDelete: Cascade)
  role            String     @default("view")
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([collectionId, granteeUserId])
  @@index([collectionId])
  @@index([granteeUserId])
}

/// A comment or a reply, anchored to a board.
///
/// A thread has no table of its own: the root comment (`rootId == null`) IS
/// the thread. Resolve/reopen only ever apply to a root; a reply inherits its
/// thread's state by following `rootId`, so there is exactly one place that
/// says whether a conversation is open. Two tables describing the same
/// conversation is the mistake this project already paid for once (see
/// ACCESS_RANK in authz/sharing.ts) and NIL-324's exit criteria name it by
/// name: no separate comment/activity truths.
///
/// Deliberately no edit-history table: an edit overwrites `body` and stamps
/// `editedAt`; prior text is not retained. A delete is a tombstone
/// (`deletedAt` set, `body` cleared) rather than a row removal, so a reply
/// chain never loses its root out from under it.
///
/// `elementId`/`anchorX`/`anchorY` are not foreign keys: canvas elements live
/// inside `Drawing.elements` JSON, not in a relational table (see
/// DocumentPageView above for the same shape). Whether that element still
/// exists is resolved by the client against the live scene it already holds
/// -- the server stores the anchor, it does not police it. A vanished element
/// degrades the thread to board-level context; it does not delete the
/// comment.
model Comment {
  id              String    @id @default(uuid())
  drawingId       String
  drawing         Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  /// Null on a thread root. Points at the root on every reply.
  rootId          String?
  root            Comment?  @relation("CommentReplies", fields: [rootId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentReplies")
  /// Set once, from the server's own session/auth read -- never from the
  /// request body. A guest holding only an unauthenticated link cannot
  /// author a comment at all (see docs/architecture/... HANDOFF for the
  /// Gastpfad decision); every row here has a real account behind it.
  authorUserId    String
  author          User      @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  body            String
  elementId       String?
  anchorX         Float?
  anchorY         Float?
  /// Root-only. A reply's resolved state is read off its root.
  resolvedAt      DateTime?
  resolvedByUserId String?
  resolvedBy      User?     @relation("CommentResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  editedAt        DateTime?
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?     @relation("CommentDeleter", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mentions        Mention[]
  activityEvents  ActivityEvent[]

  @@index([drawingId, rootId, createdAt])
  @@index([drawingId, resolvedAt])
  @@index([authorUserId])
  @@index([rootId])
}

/// One row per person named in a comment, idempotent on retry.
///
/// The mention target is re-validated server-side against the drawing's
/// roster at write time -- the client's picker only narrows what is offered,
/// it is never trusted for who actually gets notified (NIL-353: no
/// information about people who cannot see the board).
model Mention {
  id               String   @id @default(uuid())
  commentId        String
  comment          Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId  String
  mentionedUser    User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
}

/// The append-only feed a comment, mention, resolve or reopen writes into.
///
/// This is the one truth the Activity Feed, the Inbox and Notifications all
/// read -- none of them keep their own copy of "what happened". `commentId`
/// is the authoritative link back to current state; `elementId`/anchor and
/// `summary` are a snapshot taken at event time so an edit made an hour later
/// does not silently rewrite what the feed already showed.
model ActivityEvent {
  id           String    @id @default(uuid())
  drawingId    String
  drawing      Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  actorUserId  String
  actor        User      @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  /// "comment.created" | "comment.edited" | "comment.resolved" |
  /// "comment.reopened" | "comment.deleted" | "mention.created"
  verb         String
  commentId    String?
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  elementId    String?
  anchorX      Float?
  anchorY      Float?
  summary      String
  createdAt    DateTime  @default(now())

  notifications Notification[]

  @@index([drawingId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([commentId])
}

/// One notification per recipient per event. The unique constraint is what
/// makes fan-out idempotent: a retried "create comment" request re-runs
/// mention resolution, and must not hand the same person a second unread row
/// for the same event.
model Notification {
  id              String        @id @default(uuid())
  recipientUserId String
  recipient       User          @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  activityEventId String
  activityEvent   ActivityEvent @relation(fields: [activityEventId], references: [id], onDelete: Cascade)
  /// "mention" | "reply" | "resolve"
  kind            String
  readAt          DateTime?
  createdAt       DateTime      @default(now())

  @@unique([recipientUserId, activityEventId])
  @@index([recipientUserId, readAt, createdAt])
}

/// When this account last opened this board, for its own "new since you were
/// last here" marker. Upserted on join, never read by anyone but its owner.
model DrawingVisit {
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drawingId     String
  drawing       Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  lastVisitedAt DateTime @default(now())

  @@id([userId, drawingId])
  @@index([drawingId])
}

/// The same marker, once per account, for the team-wide Activity Feed rather
/// than one board. A second table rather than a sentinel drawingId in
/// DrawingVisit: "the team feed" is not a board and should not pretend to be
/// one to reuse a row shape.
model TeamActivityVisit {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())
}

model Library {
  id        String   @id
  items     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyId      String    @unique
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("drawings:read,drawings:write,collections:read,collections:write")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([keyId, revokedAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String?
  ipAddress String?
  userAgent String?
  details   String?
  createdAt DateTime @default(now())
}

model AuthIdentity {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  issuer      String
  subject     String
  emailAtLink String
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([issuer, subject])
  @@unique([provider, userId])
  @@index([userId])
}

/// Per-(drawing, fileId) S3 object record. Excalidraw fileIds are content
/// hashes that legitimately repeat across drawings, so the primary key
/// includes drawingId to keep each reference accounted for separately.
model S3File {
  drawingId String
  fileId    String // Excalidraw fileId (same id used in Drawing.files)
  userId    String // owner who uploaded the file
  s3Key     String // full object key, e.g. "excalidash/userId/drawingId/fileId.png"
  mimeType  String
  createdAt DateTime @default(now())

  @@id([drawingId, fileId])
  @@index([userId])
  @@index([drawingId])
}

/// Bytes on disk, addressed by their content hash.
///
/// Separate from Asset on purpose: the same document dropped onto three boards
/// by three people is one file on disk but three assets, each with its own
/// name, owner and quota. Sharing Asset rows across owners instead would make
/// deleting one person's document able to take away someone else's.
model StoredBlob {
  id                  String        @id @default(uuid())
  sha256              String        @unique
  /// Size of the original content — what a reader receives.
  sizeBytes           Int
  /// Size on disk. Smaller when the content was worth compressing.
  storedBytes         Int
  /// Set when the file is stored compressed and must be served that way.
  contentEncoding     String?
  storageKey          String        @unique
  /// Origin of the bytes; preview cache blobs remain identifiable after row races.
  purpose             String        @default("ASSET")
  /// STAGING while the upload is still running, READY once it is usable,
  /// DELETING once nothing references it any more.
  state               String        @default("STAGING")
  /// Set when the last reference goes away. A grace period means a board
  /// deleted by mistake and restored from a snapshot still finds its bytes.
  deleteAfter         DateTime?
  assets              Asset[]
  linkPreviewImages   LinkPreview[] @relation("LinkPreviewImage")
  linkPreviewFavicons LinkPreview[] @relation("LinkPreviewFavicon")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([state, deleteAfter])
  @@index([purpose, createdAt])
}

/// Cached public metadata. Foreign image URLs never leave the backend; only
/// references to sanitized local blobs are exposed to board viewers.
model LinkPreview {
  id             String   @id @default(uuid())
  cacheKey       String   @unique
  requestedUrl   String
  resolvedUrl    String?
  status         String
  failureCode    String?
  title          String?
  description    String?
  imageBlobId    String?
  faviconBlobId  String?
  /// Creator charged for this cache entry. Null only for rows predating this field.
  ownerUserId    String?
  expiresAt      DateTime
  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imageBlob   StoredBlob? @relation("LinkPreviewImage", fields: [imageBlobId], references: [id], onDelete: SetNull)
  faviconBlob StoredBlob? @relation("LinkPreviewFavicon", fields: [faviconBlobId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([ownerUserId, lastAccessedAt])
  @@index([lastAccessedAt])
  @@index([imageBlobId])
  @@index([faviconBlobId])
}

/// A document as a person thinks of it: a name, an owner, a page count.
model Asset {
  id               String    @id @default(uuid())
  ownerUserId      String
  /// Whoever performed the upload. May differ from the owner when someone with
  /// edit access drops a file onto a board that is not theirs; quota is still
  /// charged to the board owner.
  uploadedByUserId String?
  blobId           String
  /// PDF, MARKDOWN or TEXT.
  kind             String
  /// Shown to people and used as the download name. Never used as a path.
  originalName     String
  /// Determined by the server from the bytes, never taken from the request.
  mimeType         String
  pageCount        Int?
  status           String    @default("READY")
  deleteAfter      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner      User                   @relation("AssetOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadedBy User?                  @relation("AssetUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  blob       StoredBlob             @relation(fields: [blobId], references: [id], onDelete: Restrict)
  drawings   DrawingAsset[]
  snapshots  DrawingSnapshotAsset[]
  pageViews  DocumentPageView[]

  @@index([ownerUserId, createdAt])
  @@index([blobId])
  @@index([status, deleteAfter])
}

/// Which documents a board currently uses.
///
/// PENDING covers the gap between uploading a file and saving the board that
/// refers to it. An upload nobody ever saved is swept up rather than kept.
model DrawingAsset {
  drawingId String
  assetId   String
  state     String    @default("PENDING")
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([drawingId, assetId])
  @@index([assetId])
  @@index([state, expiresAt])
}

/// Which page of a document everyone in the room is looking at.
///
/// Deliberately not part of the board. A page turn is not a drawing change: it
/// must not bump an element version, land in undo history, or collide with
/// somebody moving a shape at the same moment. Keeping it beside the board also
/// means a read-only visitor can still be shown the page the room is on.
///
/// One row per widget, not per document, so the same file placed twice can show
/// two different pages side by side.
model DocumentPageView {
  drawingId String
  /// The embeddable element carrying the widget. Not a foreign key: elements
  /// live inside the board's JSON, so nothing here can point at them.
  elementId String
  assetId   String
  page      Int
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([drawingId, elementId])
  @@index([assetId])
}

/// Which documents a snapshot needs, so restoring an old version still finds
/// the file it referred to.
model DrawingSnapshotAsset {
  snapshotId String
  assetId    String

  snapshot DrawingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  asset    Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([snapshotId, assetId])
  @@index([assetId])
}
