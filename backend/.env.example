# Backend Environment Variables
PORT=8000
NODE_ENV=production
# Database provider: sqlite or postgresql
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/app/prisma/dev.db
FRONTEND_URL=http://localhost:6767
# Keep disabled unless traffic always comes through a trusted reverse proxy.
TRUST_PROXY=false
# Set false if an outer gateway already handles HTTP-to-HTTPS redirects.
ENFORCE_HTTPS_REDIRECT=true
AUTH_MODE=local
JWT_SECRET=change-this-secret-in-production-min-32-chars
CSRF_SECRET=change-this-secret-in-production
# Socket.IO packet ceiling. The 16 MiB default sits above the 15 MiB event
# parser and below every board budget, so oversized events receive an ack
# instead of dying at the transport. Startup rejects values outside that order.
# SOCKET_MAX_HTTP_BUFFER_MB=16
# Pepper mixed into the scrypt hash of API keys at rest. Set a unique value in
# production; changing it later invalidates all existing API keys.
# API_KEY_HASH_PEPPER=change-this-api-key-pepper-in-production

# Optional Feature Flags
# Set to "true" or "1" to enable:
# ENABLE_PASSWORD_RESET=false

# --- Outbound mail (required when ENABLE_PASSWORD_RESET=true) ---------------
# Without a provider the password reset endpoint answers 503 instead of
# pretending a link was sent. In development the link is printed to the log.
# Transport: resend | smtp | none. Unset follows whatever is configured.
# MAIL_TRANSPORT=smtp
#
# Option A - SMTP (works with any mail server or relay you already run)
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
#
# Option B - Resend (HTTP API, no mail server needed)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=ExcaliDash <noreply@your-domain.com>
# MAIL_REPLY_TO=support@your-domain.com
#
# Turn OFF click tracking for the sending domain in the Resend dashboard:
# it rewrites links, which breaks the trust of a password reset URL.
# ENABLE_REFRESH_TOKEN_ROTATION=true
# ENABLE_AUDIT_LOGGING=false

# Store version-history snapshots Brotli-compressed (base64, "br1:" prefix).
# Snapshots written before this was enabled stay readable, so it can be toggled freely.
ENABLE_SNAPSHOT_COMPRESSION=true
# Maximum full-scene history records retained per drawing, in addition to the
# time-based cleanup. Bounds write-heavy boards inside the retention window.
SNAPSHOT_MAX_COUNT_PER_DRAWING=100

# After pruning old snapshots, hand the freed SQLite pages back to the
# filesystem. Runs at most once a week and only when a large share of a large
# file is free; skipped entirely on PostgreSQL. Set to false to disable.
ENABLE_SNAPSHOT_VACUUM=true

# When FRONTEND_URL uses https://, the backend will redirect plain-HTTP requests
# to HTTPS by default. Set to "false" when your external gateway (Nginx, Traefik,
# Caddy, etc.) already enforces HTTPS and you want to prevent double-redirect
# loops or want to delegate HTTPS enforcement entirely to the outer proxy.
# ENFORCE_HTTPS_REDIRECT=true

# Migration control
# For SQLite in Kubernetes, prefer running migrations once via a Job/init container
# and set RUN_MIGRATIONS=false on the main Deployment to avoid concurrent migrates.
# RUN_MIGRATIONS=true
# MIGRATION_LOCK_TIMEOUT_SECONDS=120

# Upgrade safety
# If true, disables the production onboarding gate that blocks API usage until
# "Choose Authentication Mode" is completed. Not recommended.
# DISABLE_ONBOARDING_GATE=true

# Update notifier (GitHub release checks)
# If false, disables outbound requests to the GitHub API (update checks will be unavailable).
# UPDATE_CHECK_OUTBOUND=true
# Optional GitHub token to increase API rate limits (public repo scopes are fine).
# UPDATE_CHECK_GITHUB_TOKEN=


# Local-auth password policy
# Defaults keep the previous strong 12-character complex policy. Internal-only
# installs can relax these, e.g. PASSWORD_MIN_LENGTH=10 and all REQUIRE_* false.
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MAX_LENGTH=100
# PASSWORD_REQUIRE_UPPERCASE=true
# PASSWORD_REQUIRE_LOWERCASE=true
# PASSWORD_REQUIRE_NUMBER=true
# PASSWORD_REQUIRE_SYMBOL=true

# Scheduled SQLite backups
# Five- or six-field cron. Example: daily at 04:00:00.
# Backups are a full DB copy (password/API-key hashes, OIDC secrets); the
# directory is created 0700 and files 0600. Point BACKUP_DIR outside the
# served application tree so backups are never reachable over HTTP.
# BACKUP_SCHEDULE=0 0 4 * * *
# BACKUP_DIR=/app/backups
# BACKUP_RETENTION_DAYS=14
# Keep at most this many completed full backups, and never let their combined
# archive size exceed the byte budget. A new backup is refused before writing
# if it cannot preserve the free-space floor.
# BACKUP_MAX_COUNT=7
# BACKUP_MAX_TOTAL_MB=30720
# BACKUP_MIN_FREE_DISK_PERCENT=20

# Streaming import limits. nginx streams these routes without its own size
# ceiling. The archive limit bounds the uploaded ZIP on disk;
# entry and extracted limits are checked while inflating, so a small ZIP cannot
# expand until it fills the server. Keep the extracted limit at least as large
# as the document quota if full user exports must remain importable.
# IMPORT_MAX_ARCHIVE_MB=2300
# IMPORT_MAX_ENTRY_MB=128
# IMPORT_MAX_EXTRACTED_MB=2200
# Parsed drawing/snapshot JSON is held separately from streamed document bytes.
# Keep this below the Node heap budget of the host.
IMPORT_MAX_SCENE_MEMORY_MB=64

# Periodic authentication/audit retention (runs daily by default).
# Terminal refresh/reset tokens are retained for incident review before being
# deleted. Audit logs use a longer, conservative default retention period.
# AUTH_CLEANUP_SCHEDULE=0 0 3 * * *
# AUTH_TOKEN_RETENTION_DAYS=30
# AUDIT_LOG_RETENTION_DAYS=365

# One-time bootstrap setup code (first admin registration)
# BOOTSTRAP_SETUP_CODE_TTL_MS=900000
# BOOTSTRAP_SETUP_CODE_MAX_ATTEMPTS=10

# ---------------------------------------------------------------------------
# S3 / S3-Compatible Object Storage (optional)
# ---------------------------------------------------------------------------
# When S3_BUCKET is set, ExcaliDash uploads image dataURLs to S3 on save
# instead of embedding base64 in SQLite, keeping the database compact.
# Compatible with AWS S3, Cloudflare R2, MinIO, Alibaba OSS, and any
# S3-protocol service.
#
# Architecture: images are received as base64 from the frontend on save,
# uploaded server-side, and the dataURL in Drawing.files is rewritten to
# the resulting S3 (or /api/files/:drawingId/:fileId) URL before
# persisting. No browser-direct upload, no presigned PUT URLs, no CORS
# rules required on the bucket.
#
# Required to enable S3:
# S3_BUCKET=my-excalidash-bucket
# S3_REGION=us-east-1
#
# Optional credentials (omit to use IAM roles / instance metadata):
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Optional custom endpoint for S3-compatible services:
# S3_ENDPOINT=https://s3.example.com
#
# Path-style addressing (default false: virtual-hosted-style URLs).
# Set to true for MinIO. Leave false (or unset) for AWS S3 / Cloudflare
# R2 / Alibaba OSS, which all use virtual-hosted-style URLs.
# S3_FORCE_PATH_STYLE=false
#
# Object key prefix (default "excalidash"). Final key layout is
# {prefix}/{userId}/{drawingId}/{fileId}.{ext}. Avoid '/' in the prefix
# itself so the upgrade migration's drawingId extraction works.
# S3_KEY_PREFIX=excalidash
#
# Public-URL mode (recommended): set to the bucket's public base URL
# (or a CDN in front of it) so images are served directly without
# hitting ExcaliDash. Without this, ExcaliDash redirects to a
# short-lived presigned GET URL via /api/files/:drawingId/:fileId.
# Both http:// and https:// are accepted (use http:// for local MinIO).
# S3_PUBLIC_URL=https://my-excalidash-bucket.s3.amazonaws.com

# OIDC Configuration (required when AUTH_MODE=hybrid or AUTH_MODE=oidc_enforced)
# OIDC_PROVIDER_NAME=Authentik
# OIDC_ISSUER_URL=https://auth.example.com/application/o/excalidash/
# Optional: internal backend-only discovery URL for split-horizon networking.
# Example: browser uses OIDC_ISSUER_URL=https://auth.example.com while backend discovers via http://auth:9000
# OIDC_DISCOVERY_URL=http://auth-internal:9000/application/o/excalidash/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://excalidash.example.com/api/auth/oidc/callback
# OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
# OIDC_SCOPES=openid profile email
# OIDC_EMAIL_CLAIM=email
# OIDC_EMAIL_VERIFIED_CLAIM=email_verified
# OIDC_GROUPS_CLAIM=groups
# Comma-separated OIDC groups/roles that should have ADMIN privileges.
# When configured, OIDC users are promoted/demoted on authenticated requests.
# OIDC_ADMIN_GROUPS=excalidash-admins,platform-admins
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# OIDC_JIT_PROVISIONING=true
# OIDC_FIRST_USER_ADMIN=true

# Refresh lifetime for logins that ticked "stay signed in".
# JWT_REFRESH_EXPIRES_IN_REMEMBERED=30d

# --- Documents on boards -------------------------------------------------
# Where uploaded documents and their rendered pages live. Sits inside the
# existing backend-data volume, so an instance that already backs that volume
# up keeps working without a new mount.
# ASSET_STORAGE_DIR=/app/prisma/assets
#
# Serving documents from a cookie-free host reduces what a mistake in this area
# could reach. Unset means the app's own origin.
# ASSET_FILE_BASE_URL=
#
# nginx streams this route without its own size ceiling; the backend counts the
# bytes while writing staging and returns a structured 413 at this limit.
# ASSET_MAX_UPLOAD_MB=30
# ASSET_MAX_PER_USER_MB=2048
#
# Rendered pages are recomputable, so this is a ceiling to evict against rather
# than a quota to respect.
# ASSET_CACHE_BUDGET_MB=512
#
# Stop rendering before the disk is full: a machine that cannot write is worse
# than a document that is slow to open.
# ASSET_MIN_FREE_DISK_PERCENT=20
# ASSET_RENDER_CONCURRENCY=1
# Maximum distinct page renders waiting behind the active renderer.
# ASSET_RENDER_QUEUE_LIMIT=32
#
# Rebuilding an uploaded PDF re-encodes its images and can make an image-heavy
# document a fraction of its size: measured 13 MB -> 4.1 MB and 76 MB -> 14 MB.
# A text-only document grows instead, so the rebuild is only kept when it came
# out smaller, and files below the threshold are never touched.
# "printer" keeps images at 300 dpi and is not distinguishable at viewing size.
# Note that this changes the file: a download returns the rebuilt document, not
# the bytes that were uploaded. Set to off to keep every upload untouched.
# ASSET_PDF_SHRINK=printer
# ASSET_PDF_SHRINK_MIN_MB=4
# ASSET_PDF_SHRINK_CONCURRENCY=1
# ASSET_PDF_SHRINK_QUEUE_LIMIT=2

# --- Link previews -------------------------------------------------------
# Metadata and failed lookups are both cached. Limits apply separately to
# compressed transport bytes and bytes after HTTP decompression.
# LINK_PREVIEW_POSITIVE_TTL_MS=86400000
# LINK_PREVIEW_NEGATIVE_TTL_MS=900000
# LINK_PREVIEW_DNS_TIMEOUT_MS=2000
# LINK_PREVIEW_CONNECT_TIMEOUT_MS=3000
# LINK_PREVIEW_TOTAL_TIMEOUT_MS=8000
# LINK_PREVIEW_MAX_REDIRECTS=3
# Only normal web ports are enabled by default. Add a port explicitly only for
# a trusted deployment that serves public websites elsewhere.
# LINK_PREVIEW_ALLOWED_PORTS=80,443
# LINK_PREVIEW_DNS_CONCURRENCY=8
# LINK_PREVIEW_DNS_QUEUE_SIZE=64
# LINK_PREVIEW_MAX_PAGE_WIRE_KB=256
# LINK_PREVIEW_MAX_PAGE_DECODED_KB=512
# LINK_PREVIEW_MAX_IMAGE_WIRE_MB=4
# LINK_PREVIEW_MAX_IMAGE_DECODED_MB=8
# LINK_PREVIEW_MAX_STORED_IMAGE_MB=2
# LINK_PREVIEW_MAX_IMAGE_PIXELS=16000000
# LINK_PREVIEW_MAX_IMAGE_DIMENSION=2048
# LINK_PREVIEW_MAX_FAVICON_DIMENSION=256
# LINK_PREVIEW_IMAGE_TIMEOUT_MS=10000
# LINK_PREVIEW_CONCURRENCY_PER_USER=2
# LINK_PREVIEW_CONCURRENCY_INSTANCE=4
# LINK_PREVIEW_QUEUE_SIZE=16
# Preview art is expendable cache data. Keep it below a global disk budget,
# bound unique entries created by one account, and preserve filesystem reserve.
# LINK_PREVIEW_CACHE_BUDGET_MB=256
# LINK_PREVIEW_MAX_PER_USER_MB=64
# LINK_PREVIEW_MAX_ENTRIES_PER_USER=100
# LINK_PREVIEW_MIN_FREE_DISK_PERCENT=20
# LINK_PREVIEW_CLEANUP_BATCH_SIZE=100
