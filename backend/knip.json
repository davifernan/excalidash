{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.{test,integration,spec}.ts",
    "src/securityTest.ts",
    "src/backups/runOnce.ts",
    "src/workers/db-verify.js",
    "src/__tests__/prismaClientResolutionDiagnosticsRunner.ts",
    "scripts/backfill-collection-ownership.cjs",
    "scripts/migrate-sqlite-to-postgres.cjs",
    "scripts/provider-prisma.cjs",
    "scripts/gate-run/setup-gate2.ts",
    "scripts/gate-run/setup-gate3.ts"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx,mjs,cjs}",
    "!node_modules/**",
    "!dist/**"
  ],
  "ignoreDependencies": [
    "@prisma/client",
    "@excalidash/domain",
    "@types/express-serve-static-core",
    "nodemon",
    "prettier",
    "prisma",
    "ts-node"
  ],
  "ignoreBinaries": [
    "psql",
    "pg_restore"
  ]
}
