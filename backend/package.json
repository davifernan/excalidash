{
  "name": "backend",
  "version": "0.13.0",
  "description": "",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "npm run build --workspace @excalidash/domain",
    "build": "prisma generate && tsc",
    "pretypecheck": "npm run build --workspace @excalidash/domain",
    "typecheck": "tsc --noEmit",
    "predev": "npm run build --workspace @excalidash/domain && node scripts/predev-migrate.cjs",
    "dev": "nodemon src/index.ts",
    "start": "node dist/index.js",
    "admin:recover": "node scripts/admin-recover.cjs",
    "dev:simulate-auth-onboarding:fresh": "node scripts/simulate-auth-onboarding.cjs --scenario fresh",
    "dev:simulate-auth-onboarding:migration": "node scripts/simulate-auth-onboarding.cjs --scenario migration",
    "dev:simulate-auth-onboarding:dry-run": "node scripts/simulate-auth-onboarding.cjs --scenario migration --dry-run",
    "oidc:doctor": "node scripts/oidc-doctor.cjs",
    "pretest": "npm run build --workspace @excalidash/domain",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check:dead-code": "npx --yes knip@5.88.1 --include files,dependencies,devDependencies"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@excalidash/domain": "file:../packages/domain",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "10.71.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dompurify": "^3.4.14",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsdom": "^29.0.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.5",
    "openid-client": "^5.7.1",
    "prisma": "^5.22.0",
    "resend": "^6.19.0",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.5",
    "@types/express-serve-static-core": "5.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.11",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
