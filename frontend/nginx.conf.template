events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Preserve upstream TLS context (if present) when proxying to backend.
    # Falls back to current scheme when no forwarded proto is provided.
    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        ~*^https(?:,|$) https;
        ~*^http(?:,|$) http;
    }

    sendfile on;
    keepalive_timeout 65;
    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Never write query strings to access logs. Share secrets normally arrive
    # in headers, but direct document URLs use a query parameter because image
    # elements cannot set request headers.
    log_format excalidash '$remote_addr - [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
    access_log /var/log/nginx/access.log excalidash;

    # Set maximum request body size to 50MB to handle large drawings with embedded images
    client_max_body_size 50M;

    server {
        listen 80;
        server_name localhost;
        root /usr/share/nginx/html;
        index index.html;

        include /etc/nginx/security-headers.conf;

        # Upload bodies stream to the backend, which is the size authority and
        # returns structured JSON rejections. Disabling nginx's second ceiling
        # also means ASSET_MAX_UPLOAD_MB and IMPORT_MAX_ARCHIVE_MB can change
        # without rebuilding the frontend image. Ordinary JSON stays at 50 MB.
        location = /api/import/excalidash {
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_pass http://__BACKEND_URL__/import/excalidash;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            client_body_buffer_size 128k;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location = /api/import/excalidash/verify {
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_pass http://__BACKEND_URL__/import/excalidash/verify;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            client_body_buffer_size 128k;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location = /api/import/sqlite/legacy {
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_pass http://__BACKEND_URL__/import/sqlite/legacy;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            client_body_buffer_size 128k;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        location = /api/import/sqlite/legacy/verify {
            client_max_body_size 0;
            proxy_request_buffering off;
            proxy_pass http://__BACKEND_URL__/import/sqlite/legacy/verify;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            client_body_buffer_size 128k;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # The raw asset body is also counted while the backend writes staging.
        # This regex is anchored so reads and unrelated drawing APIs retain the
        # ordinary 50 MB nginx ceiling.
        location ~ ^/api/drawings/[^/]+/assets$ {
            client_max_body_size 0;
            proxy_request_buffering off;
            rewrite ^/api/(.*)$ /$1 break;
            proxy_pass http://__BACKEND_URL__;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            client_body_buffer_size 128k;
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # API and WebSocket proxy to backend
        # BACKEND_URL is substituted at container startup (default: backend:8000)
        location /api/ {
            proxy_pass http://__BACKEND_URL__/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            
            # Buffer and timeout settings for large payloads
            proxy_buffering on;
            proxy_buffer_size 4k;
            proxy_buffers 8 4k;
            proxy_busy_buffers_size 8k;
            client_body_buffer_size 128k;
            
            # Timeouts for large uploads (300 seconds)
            proxy_connect_timeout 300s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # WebSocket proxy for Socket.IO
        location /socket.io/ {
            proxy_pass http://__BACKEND_URL__/socket.io/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $host;
            proxy_cache_bypass $http_upgrade;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            
            # Longer timeouts for WebSocket connections
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Frontend routes
        location / {
            try_files $uri $uri/ /index.html;
        }

        # Never cache the HTML shell. Vite builds use hashed asset filenames, so caching
        # index.html is the primary way users end up stuck on an old UI after upgrades.
        #
        # NIL-667: nginx only inherits a parent block's add_header directives when the
        # current location has none of its own -- the moment a location adds even one
        # add_header (Cache-Control here), every server-level security header silently
        # stops applying to it. Since try_files in `location /` above lands almost every
        # real page request on this exact block, that dropped CSP/X-Frame-Options/nosniff/
        # Permissions-Policy from nearly all real page loads. `include` the shared
        # security-headers.conf explicitly in every location below that sets its own
        # add_header, rather than relying on inheritance from the server block.
        location = /index.html {
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
            include /etc/nginx/security-headers.conf;
            expires -1;
            try_files /index.html =404;
        }

        # Generated at container startup from ERROR_TRACKER_DSN. It must not
        # survive an operator disabling or rotating the DSN on a later restart.
        location = /runtime-config.js {
            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
            include /etc/nginx/security-headers.conf;
            expires -1;
            try_files /runtime-config.js =404;
        }

        # Cache static assets
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 1y;
            add_header Cache-Control "public, immutable" always;
            include /etc/nginx/security-headers.conf;
        }
    }
}
