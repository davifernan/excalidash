{
  "name": "frontend",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare:excalidraw": "node scripts/expose-excalidraw-command-palette.mjs",
    "postinstall": "npm run prepare:excalidraw",
    "predev": "npm run prepare:excalidraw",
    "dev": "node scripts/copy-excalidraw-assets.mjs --public && vite --port 6767",
    "pretypecheck": "npm run build --workspace @excalidash/domain && npm run prepare:excalidraw",
    "typecheck": "node ../scripts/notification-boundary.cjs && tsc -b",
    "build": "npm run typecheck && vite build && node scripts/copy-excalidraw-assets.mjs --dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "pretest": "npm run build --workspace @excalidash/domain && npm run prepare:excalidraw",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:config-keys": "node scripts/config-duplicate-keys.cjs && node scripts/config-duplicate-keys.test.cjs",
    "check:dead-code": "npx --yes knip@5.88.1 --include files,dependencies,devDependencies",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@excalidash/domain": "file:../packages/domain",
    "@excalidraw/excalidraw": "0.18.1",
    "@sentry/react": "10.71.0",
    "@types/lodash": "^4.17.20",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "date-fns": "^4.1.0",
    "decode-named-character-reference": "^1.3.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-url-attributes": "^3.0.1",
    "jszip": "^3.10.1",
    "lodash": "^4.18.1",
    "lucide-react": "^0.554.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.9",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.10",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "immutable": "4.3.9",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16",
      "@mermaid-js/parser": "1.2.1"
    },
    "lodash-es": "4.18.1"
  }
}
