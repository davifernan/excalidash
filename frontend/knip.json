{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/**/*.{test,spec}.{ts,tsx}", "scripts/**/*.{js,mjs,cjs,ts}"],
  "ignoreDependencies": [
    "decode-named-character-reference",
    "@excalidash/domain",
    "eslint",
    "happy-dom",
    "prettier"
  ],
  "ignore": ["public/runtime-config.js"],
  "project": ["**/*.{js,jsx,ts,tsx,mjs,cjs,css}", "!node_modules/**", "!dist/**"]
}
