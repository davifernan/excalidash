{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.{test,spec}.{ts,tsx}"
  ],
  "ignore": ["public/runtime-config.js"],
  "ignoreDependencies": [
    "@excalidash/domain",
    "decode-named-character-reference",
    "eslint",
    "happy-dom",
    "prettier"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx,mjs,cjs,css}",
    "!node_modules/**",
    "!dist/**"
  ]
}
