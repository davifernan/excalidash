{
  "name": "@excalidash/domain",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "documents": [
        "dist/documents/index.d.ts"
      ],
      "documents/pagination": [
        "dist/documents/pagination.d.ts"
      ],
      "customData": [
        "dist/customData/index.d.ts"
      ],
      "customData/widget": [
        "dist/customData/widget.d.ts"
      ],
      "collaboration": [
        "dist/collaboration/index.d.ts"
      ],
      "collaboration/cursorChat": [
        "dist/collaboration/cursorChat.d.ts"
      ],
      "authz": [
        "dist/authz/index.d.ts"
      ],
      "authz/drawingAccess": [
        "dist/authz/drawingAccess.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "default": "./dist/documents/index.js"
    },
    "./documents/pagination": {
      "types": "./dist/documents/pagination.d.ts",
      "default": "./dist/documents/pagination.js"
    },
    "./customData": {
      "types": "./dist/customData/index.d.ts",
      "default": "./dist/customData/index.js"
    },
    "./customData/widget": {
      "types": "./dist/customData/widget.d.ts",
      "default": "./dist/customData/widget.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration/index.d.ts",
      "default": "./dist/collaboration/index.js"
    },
    "./collaboration/cursorChat": {
      "types": "./dist/collaboration/cursorChat.d.ts",
      "default": "./dist/collaboration/cursorChat.js"
    },
    "./authz": {
      "types": "./dist/authz/index.d.ts",
      "default": "./dist/authz/index.js"
    },
    "./authz/drawingAccess": {
      "types": "./dist/authz/drawingAccess.d.ts",
      "default": "./dist/authz/drawingAccess.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
