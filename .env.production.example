# Pin both fork images to one published, reviewed commit. Never use `latest` in
# production. Verify both manifests before changing this value; see FORK.md.
EXCALIDASH_IMAGE_TAG=sha-54cdcc9

# Replace this placeholder with the public origin users open in their browser.
# The backend uses it as the CORS allowlist and for links in outgoing mail.
FRONTEND_URL=https://excalidash.example.com

# For portable backups or multiple backend instances, run `openssl rand -hex 32`
# separately for each variable and paste the two independent values here. Leave
# them empty only for a single backend instance: its entrypoint generates and
# persists both secrets in the backend volume on first start.
JWT_SECRET=
CSRF_SECRET=

# Optional self-hosted error tracking. The observability profile starts
# GlitchTip plus Postgres, explicitly without Redis/Valkey. ERROR_TRACKER_DSN
# independently enables delivery from both app containers. Generate the two
# secrets separately with `openssl rand -hex 32`; keep the DB password URL-safe.
GLITCHTIP_PORT=8088
GLITCHTIP_DOMAIN=https://glitchtip.example.com
GLITCHTIP_ALLOWED_HOSTS=glitchtip.example.com
GLITCHTIP_CSRF_TRUSTED_ORIGINS=https://glitchtip.example.com
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_NAME=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_RETENTION_DAYS=90
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@example.com
# Used only by scripts/glitchtip-bootstrap.sh, not passed to the service.
GLITCHTIP_ADMIN_EMAIL=admin@example.com
GLITCHTIP_ADMIN_PASSWORD=
ERROR_TRACKER_DSN=
