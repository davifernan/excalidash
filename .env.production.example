# Pin both fork images to one published, reviewed commit. Never use `latest` in
# production. Verify both manifests before changing this value; see FORK.md.
EXCALIDASH_IMAGE_TAG=sha-54cdcc9

# Replace this placeholder with the public origin users open in their browser.
# The backend uses it as the CORS allowlist and for links in outgoing mail.
FRONTEND_URL=https://excalidash.example.com

# For portable backups or multiple backend instances, run `openssl rand -hex 32`
# separately for each variable and paste the two independent values here. Leave
# them empty only for a single backend instance: its entrypoint generates and
# persists both secrets in the backend volume on first start.
JWT_SECRET=
CSRF_SECRET=

# Optional self-hosted error tracking. The observability profile starts
# Bugsink; ERROR_TRACKER_DSN independently enables delivery from both app
# containers. Generate BUGSINK_SECRET_KEY with: openssl rand -base64 50
BUGSINK_PORT=8088
BUGSINK_BASE_URL=https://bugsink.example.com
BUGSINK_SECRET_KEY=
# Format: admin@example.com:<a unique strong password>
BUGSINK_CREATE_SUPERUSER=
BUGSINK_BEHIND_HTTPS_PROXY=True
ERROR_TRACKER_DSN=
