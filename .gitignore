# Dependencies
frontend/node_modules
backend/node_modules

# Database
backend/prisma/*.db
backend/prisma/**/*.db
backend/prisma/*.db-journal
backend/prisma/**/*.db-journal
backend/prisma/dev.db
backend/prisma/e2e-test.db
# Documents uploaded by the browser tests, which need somewhere outside the
# container path the server defaults to.
backend/prisma/e2e-assets/
backend/prisma/*.backup

# SQLite artifacts anywhere (avoid committing dev DBs)
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.backup

# Docker-entrypoint persisted secrets/locks (in case prisma volume is bind-mounted)
backend/prisma/.jwt_secret
backend/prisma/.csrf_secret
backend/prisma/.migration-lock/

# Local OIDC/Keycloak dev files
docker-compose.oidc.local.yml
ops/keycloak/realm-excalidash-local.json

# Uploads
backend/uploads/

# Generated files
backend/src/generated/

# provider-prisma.cjs's disposable schema/migrations workspace (NIL-597) --
# only ever left behind if a run is interrupted mid-generate/migrate.
backend/.prisma-workspaces.tmp/

# NIL-701 gate-run setup scripts' own output (drawing/board state; the mount
# capability tokens no longer land here at all -- see setup-gate2.ts -- but
# this stays ignored as defense in depth for whatever non-secret state does).
backend/scripts/gate-run/output/

# Environment variables
.env
.env.local
.env.production
.env.staging

# Build outputs
frontend/dist/
frontend/build/
backend/dist/
packages/domain/dist/

# Generated Excalidraw assets (copied from node_modules for runtime)
frontend/public/excalidraw-assets/
frontend/public/excalidraw-assets-dev/
frontend/public/fonts/

# E2E Testing
e2e/node_modules/
# Without the slash as well: a trailing slash only matches a directory, and a
# local run may link this in from elsewhere rather than installing it.
e2e/node_modules
e2e/test-results/
e2e/test-results-user/
e2e/playwright-report/
e2e/playwright-report-user/
e2e/.playwright/

# Temporary files
*.tmp
*.temp
*.bak

# Test artifacts (in case they appear in other locations)
**/playwright-report/
**/test-results/
**/playwright/.cache/

# Docker volumes (if any temporary ones are created)
docker-volumes/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Vitest cache
.vitest/

# Playwright screenshots/videos on failure
**/screenshots/
**/videos/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env.test

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp

# Any node_modules, not only the two package directories: a vitest cache
# artefact from the repo root was committed once because only
# frontend/ and backend/ were listed.
node_modules/

# scripts/excalidraw-canary.sh (NIL-340) writes these at repo root only when
# it finds a real deviation -- a report worth reading in the run's own
# terminal output, not a file the repo should carry between runs.
excalidraw-canary-*-report.log
